# StockWaves — Environment Variables
# Copy this to .env and fill in your values
# NEVER commit .env to git

# ── Database (Render PostgreSQL connection string; leave unset locally to use SQLite) ──
DATABASE_URL=postgresql+asyncpg://postgres:password@localhost/sam_ims

# ── Cache (Render Redis) ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Auth ────────────────────────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-this-to-a-256-bit-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── Demo data ────────────────────────────────────────────────────────────────
# true: seeds the sample shop and the public demo logins. false: start empty.
SEED_DEMO=true
# Optional first admin, created on startup when no users exist yet.
# ADMIN_EMAIL=owner@yourshop.com
# ADMIN_PASSWORD=choose-a-long-password

# ── AI Chatbot ───────────────────────────────────────────────────────────────
# Get from: https://console.groq.com
GROQ_API_KEY=your-groq-api-key

# ── Snap-a-Bill (reading supplier bills from photos) ─────────────────────────
# Uses ANTHROPIC_API_KEY if set, otherwise GROQ_API_KEY.
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# BILL_AI_PROVIDER=        # anthropic | groq (empty = automatic)
# BILL_AI_MODEL=           # optional override

# ── WhatsApp brief (optional; without these the app runs it in preview mode) ──
# WHATSAPP_TOKEN=            # permanent system-user token
# WHATSAPP_PHONE_NUMBER_ID=  # WhatsApp > API Setup
# WHATSAPP_APP_SECRET=       # App settings > Basic; webhooks are rejected without it
# WHATSAPP_VERIFY_TOKEN=     # any phrase; enter the same one in Meta's webhook setup
# WHATSAPP_BRIEF_TEMPLATE=   # approved template for mornings outside the 24-hour window (README)
# WHATSAPP_TEMPLATE_LANG=en

# ── App ──────────────────────────────────────────────────────────────────────
ENVIRONMENT=production
DEBUG=false
FRONTEND_URL=https://sam-ims-frontend.onrender.com

# ── Email (optional, for password reset) ────────────────────────────────────
# SENDGRID_API_KEY=SG.your-key-here
# FROM_EMAIL=noreply@yourdomain.com

# ── Error tracking (optional) ───────────────────────────────────────────────
# SENTRY_DSN=https://xxx@sentry.io/xxx
