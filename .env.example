# StockWaves settings. Copy to .env for local runs; on Railway set them as service variables.
# Never commit .env.

# Database. Leave unset locally to use a SQLite file (stockwaves.db).
# On Railway: ${{Postgres.DATABASE_URL}} (postgres:// URLs are converted for asyncpg automatically).
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/stockwaves

# Auth. Generate a key with: python -c "import secrets; print(secrets.token_hex(32))"
# Without it a random key is used and everyone is signed out on each restart.
SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Demo data: the sample shop and the three demo logins. Set false for a real shop.
SEED_DEMO=true
# First admin, created on startup when there are no users yet.
# ADMIN_EMAIL=owner@yourshop.com
# ADMIN_PASSWORD=choose-a-long-password

# AI (optional). Everyday commands and every number work without a key.
# A key adds free-form commands and questions, and reading supplier bills from photos.
# GROQ_API_KEY=            # https://console.groq.com
# ANTHROPIC_API_KEY=       # https://platform.claude.com (used first when both are set)
# BILL_AI_PROVIDER=        # anthropic | groq; empty picks whichever key is set
# ASSISTANT_PROVIDER=      # anthropic | groq; empty picks whichever key is set

# WhatsApp brief (optional). Without these the WhatsApp page runs in preview mode.
# WHATSAPP_TOKEN=            # permanent token of a Meta system user
# WHATSAPP_PHONE_NUMBER_ID=  # WhatsApp > API Setup, under the number
# WHATSAPP_APP_SECRET=       # App settings > Basic; webhooks without a valid signature are rejected
# WHATSAPP_VERIFY_TOKEN=     # any phrase; enter the same one in Meta's webhook setup
# WHATSAPP_BRIEF_TEMPLATE=   # approved template for mornings outside the 24-hour window
# WHATSAPP_TEMPLATE_LANG=en

# The frontend's address (CORS). Locally the Vite dev server proxies /api, so this rarely matters.
FRONTEND_URL=http://localhost:5173
